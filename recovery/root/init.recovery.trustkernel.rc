on fs
    mkdir /mnt/vendor 0755 system system
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /mnt/vendor/protect_f 0770 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro wait
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f ro wait
    exec u:r:recovery:s0 root root -- /system/bin/sh /vendor/bin/trustkernel.twrp.sh
    install_keyring
    mkdir /tmp/t6 0770 root system
    mkdir /tmp/t6/fs 0770 root system
    mkdir /tmp/t6/app 0770 root system
    chown system system /dev/tkcoredrv
    chmod 0660 /dev/tkcoredrv
    chown system system /dev/rpmb0
    chmod 0660 /dev/rpmb0
    start teed

service teed /vendor/bin/teed \
    --datapath /tmp/t6/fs \
    --sptapath /tmp/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/rpmb0 \
    --prot /tmp/t6_twrp \
    --prot /tmp/tee_twrp \
    --prebuilt /vendor/app/t6/data \
    --logpath /tmp/t6/tkcore.log \
    --proprefix vendor.trustkernel
    capabilities SYS_RAWIO
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-1-trustkernel /vendor/bin/hw/android.hardware.keymaster@4.1-service.trustkernel
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true
    start vendor.keymaster-4-1-trustkernel
    start vendor.gatekeeper-1-0
